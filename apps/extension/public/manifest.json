{
  "manifest_version": 3,
  "name": "Surge",
  "version": "1.1.0",
  "key": "",
  "description": "Surge — High-performance download manager powered by aria2c",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "cookies",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Surge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
